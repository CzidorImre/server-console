[Unit]
Description=Server Dashboard
Documentation=file:/opt/server-dashboard/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/server-dashboard
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# Runs as root so that it can reboot/poweroff the machine and can see which process
# owns each listening port. If you would rather not, see "Permissions" in the README
# for the unprivileged setup with a sudoers rule.
User=root

# Hardening that still leaves reboot, poweroff and process inspection working.
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
